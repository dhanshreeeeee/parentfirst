# PostgreSQL connection (default works if you created the db locally on Mac)
# Leave commented to auto-use your Mac username (works with Homebrew Postgres)
# DATABASE_URL=postgres://localhost:5432/parentfirst_vault

# Anthropic API key — server-side only, never exposed to the browser
ANTHROPIC_API_KEY=sk-ant-api03-...
# model tiers (optional — these are the defaults)
# AI_MODEL_EXTRACT=claude-sonnet-5-5          # reads reports and prescriptions
# AI_MODEL_ANALYSE=claude-opus-5-5            # second read, report analysis, health summary
# AI_MODEL_FAST=claude-haiku-4-5-20251001     # medicine info, quick explanations

PORT=4500

# ── Email (OTP codes, invites, alerts) ──
# Render's free tier BLOCKS SMTP ports, so use an HTTPS email API in production.
RESEND_API_KEY=
EMAIL_FROM=ParentFirst <hello@parentfirst.app>
# BREVO_API_KEY=           # alternative to Resend
# SMTP_HOST / SMTP_USER / SMTP_PASS still work locally or on a paid Render instance
